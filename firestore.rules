rules_version = '2';

// dateLime accounts: each person's data lives in one document, users/{uid}, and only that
// signed-in person can read, write or delete it. Nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validShape() {
        let d = request.resource.data;
        return d.keys().hasOnly(['profile', 'rules', 'saved', 'updatedAt'])
          && (!('profile' in d) || (d.profile is map
                && d.profile.keys().hasOnly(['name', 'email', 'createdAt'])
                && (!('name' in d.profile) || (d.profile.name is string && d.profile.name.size() <= 80))))
          && (!('rules' in d) || d.rules is map)
          && (!('saved' in d) || (d.saved is list && d.saved.size() <= 50))
          && (!('updatedAt' in d) || d.updatedAt is string);
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validShape();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
